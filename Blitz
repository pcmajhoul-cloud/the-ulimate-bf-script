--==================================================
-- HELPERS
--==================================================

local function Tween(object, properties, duration)
	local info = TweenInfo.new(
		duration or AnimationSpeed,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)

	local tween = TweenService:Create(object, info, properties)
	tween:Play()

	return tween
end

local function AddCorner(object, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = object
	return corner
end

local function AddStroke(object, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Transparency = 0
	stroke.Parent = object
	return stroke
end

local function MakeText(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Colors.Text
	label.TextSize = size or 14
	label.Font = font or Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent
	return label
end

local function GetAccent()
	return AccentColors[AccentIndex]
end

local function Notify(text)
	local notification = Instance.new("Frame")
	notification.Name = "Notification"
	notification.Size = UDim2.new(0, 270, 0, 52)
	notification.Position = UDim2.new(1, 20, 1, -75)
	notification.AnchorPoint = Vector2.new(0, 1)
	notification.BackgroundColor3 = Colors.Panel
	notification.BorderSizePixel = 0
	notification.Parent = ScreenGui

	AddCorner(notification, 12)
	AddStroke(notification, Colors.Border)

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 4, 1, 0)
	accent.BackgroundColor3 = GetAccent()
	accent.BorderSizePixel = 0
	accent.Parent = notification

	AddCorner(accent, 4)

	local textLabel = MakeText(
		notification,
		text,
		13,
		Colors.Text,
		Enum.Font.GothamMedium
	)

	textLabel.Position = UDim2.new(0, 17, 0, 0)
	textLabel.Size = UDim2.new(1, -25, 1, 0)

	Tween(
		notification,
		{Position = UDim2.new(1, -20, 1, -75)},
		0.3
	)

	task.delay(2.5, function()
		if notification.Parent then
			Tween(
				notification,
				{Position = UDim2.new(1, 20, 1, -75)},
				0.3
			)

			task.wait(0.3)
			notification:Destroy()
		end
	end)
end

