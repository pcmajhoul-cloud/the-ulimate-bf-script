local LastPingUpdate = 0

RunService.Heartbeat:Connect(function(dt)
	-- FPS Calculation
	local FPS_Calc = 1 / dt
	FPSValue.Text = string.format("%.0f", FPS_Calc)

	-- Ping Calculation (Only update every 1 second to prevent spam/error)
	local now = tick()
	if now - LastPingUpdate > 1 then
		LastPingUpdate = now
		-- Use pcall to prevent the "GetPing is not a valid member" error from spamming
		local success, ping = pcall(function()
			return game:GetPing()
		end)
		if success then
			PingValue.Text = ping .. " ms"
		else
			PingValue.Text = "N/A"
		end
	end
end)

-- Session Timer
local StartTime = tick()
RunService.Heartbeat:Connect(function()
	local Elapsed = tick() - StartTime
	local Minutes = math.floor(Elapsed / 60)
	local Seconds = math.floor(Elapsed % 60)
	SessionValue.Text = string.format("%02d:%02d", Minutes, Seconds)
end)

