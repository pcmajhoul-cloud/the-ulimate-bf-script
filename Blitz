local function Notify(text)
	-- FIX: Check if ScreenGui exists and if a notification is already playing
	-- This prevents the "attempt to index nil" error when Roblox calls Notify internally
	if not ScreenGui or ScreenGui.Parent == nil then return end
	
	if ScreenGui:FindFirstChild("Notification") then return end

	local notification = Instance.new("Frame")
	notification.Name = "Notification"
	notification.Size = UDim2.new(0, 270, 0, 52)
	notification.Position = UDim2.new(1, 20, 1, -75)
	notification.AnchorPoint = Vector2.new(0, 1)
	notification.BackgroundColor3 = Colors.Panel
	notification.BorderSizePixel = 0
	notification.Parent = ScreenGui

	AddCorner(notification, 12)
	AddStroke(notification, Colors.Border)

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 4, 1, 0)
	accent.BackgroundColor3 = GetAccent()
	accent.BorderSizePixel = 0
	accent.Parent = notification

	AddCorner(accent, 4)

	local textLabel = MakeText(
		notification,
		text,
		13,
		Colors.Text,
		Enum.Font.GothamMedium
	)

	textLabel.Position = UDim2.new(0, 17, 0, 0)
	textLabel.Size = UDim2.new(1, -25, 1, 0)

	Tween(
		notification,
		{Position = UDim2.new(1, -20, 1, -75)},
		0.3
	)

	task.delay(2.5, function()
		if notification and notification.Parent then
			Tween(
				notification,
				{Position = UDim2.new(1, 20, 1, -75)},
				0.3
			)

			task.wait(0.3)
			notification:Destroy()
		end
	end)
end

