local tabs = {}

local function createTabButton(name, layoutOrder, pageFrame)
    local btn = Instance.new("TextButton")

    btn.Name = name .. "Tab"
    btn.BackgroundColor3 =
        pageFrame.Visible
        and BUTTON_ACTIVE
        or BUTTON_INACTIVE

    btn.BorderSizePixel = 1
    btn.BorderColor3 = ACCENT_COLOR
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.LayoutOrder = layoutOrder
    btn.Text = name
    btn.TextColor3 =
        pageFrame.Visible
        and TEXT_COLOR
        or SUBTEXT_COLOR

    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    table.insert(
        tabs,
        {
            Button = btn,
            Page = pageFrame
        }
    )

    btn.MouseButton1Click:Connect(function()
        for _, tab in ipairs(tabs) do
            local isSelected = tab.Button == btn

            tab.Page.Visible = isSelected

            playTween(tab.Button, 0.2, {
                BackgroundColor3 = isSelected and BUTTON_ACTIVE or BUTTON_INACTIVE
            })

            tab.Button.TextColor3 =
                isSelected
                and TEXT_COLOR
                or SUBTEXT_COLOR
        end
    end)

    btn.MouseEnter:Connect(function()
        if pageFrame.Visible then
            return
        end

        playTween(btn, 0.14, {BackgroundColor3 = CONTROL_HOVER})
    end)

    btn.MouseLeave:Connect(function()
        if not pageFrame.Visible then
            playTween(btn, 0.18, {BackgroundColor3 = BUTTON_INACTIVE})
        end
    end)

    return btn
end

