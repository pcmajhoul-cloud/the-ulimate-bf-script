local function CreateToggle(parent, title, description, y, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -10, 0, 58)
	container.Position = UDim2.new(0, 5, 0, y)
	container.BackgroundColor3 = Colors.Panel
	container.BorderSizePixel = 0
	container.Parent = parent

	AddCorner(container, 10)
	AddStroke(container, Colors.Border)

	local titleLabel = MakeText(
		container,
		title,
		12,
		Colors.Text,
		Enum.Font.GothamMedium
	)

	titleLabel.Position = UDim2.new(0, 14, 0, 9)
	titleLabel.Size = UDim2.new(1, -85, 0, 18)

	local descLabel = MakeText(
		container,
		description,
		9,
		Colors.SubText
	)

	descLabel.Position = UDim2.new(0, 14, 0, 29)
	descLabel.Size = UDim2.new(1, -85, 0, 15)

	local toggle = Instance.new("TextButton")
	toggle.Size = UDim2.new(0, 44, 0, 24)
	toggle.Position = UDim2.new(1, -58, 0.5, -12)
	toggle.BackgroundColor3 = Colors.Off
	toggle.Text = ""
	toggle.AutoButtonColor = false
	toggle.Parent = container

	AddCorner(toggle, 12)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 3, 0.5, -9)
	knob.BackgroundColor3 = Colors.White
	knob.BorderSizePixel = 0
	knob.Parent = toggle

	AddCorner(knob, 9)

	local enabled = false

	local function SetEnabled(value, silent)
		enabled = value

		Tween(
			toggle,
			{
				BackgroundColor3 = enabled and GetAccent() or Colors.Off
			},
			0.15
		)

		Tween(
			knob,
			{
				Position = enabled
					and UDim2.new(1, -21, 0.5, -9)
					or UDim2.new(0, 3, 0.5, -9)
			},
			0.15
		)

		callback(enabled, silent)
	end

	toggle.MouseButton1Click:Connect(function()
		SetEnabled(not enabled, false)
	end)

	return {
		Set = SetEnabled,
		Get = function()
			return enabled
		end
	}
end

--==================================================
-- SETTINGS FUNCTIONS
--==================================================

local function SetFog(value)
	if value then
		Lighting.FogStart = 0
		Lighting.FogEnd = 1000000
	else
		Lighting.FogStart = OriginalFogStart
		Lighting.FogEnd = OriginalFogEnd
	end
end

local function SaveEffectStates()
	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("ParticleEmitter") then
			OriginalParticleStates[object] = object.Enabled
		elseif object:IsA("Trail") then
			OriginalTrailStates[object] = object.Enabled
		elseif object:IsA("Beam") then
			OriginalBeamStates[object] = object.Enabled
		end
	end
end

SaveEffectStates()

local function SetPerformanceMode(value)
	if value then
		for object in pairs(OriginalParticleStates) do
			if object.Parent then
				object.Enabled = false
			end
		end

		for object in pairs(OriginalTrailStates) do
			if object.Parent then
				object.Enabled = false
			end
		end

		for object in pairs(OriginalBeamStates) do
			if object.Parent then
				object.Enabled = false
			end
		end
	else
		for object, state in pairs(OriginalParticleStates) do
			if object.Parent then
				object.Enabled = state
			end
		end

		for object, state in pairs(OriginalTrailStates) do
			if object.Parent then
				object.Enabled = state
			end
		end

		for object, state in pairs(OriginalBeamStates) do
			if object.Parent then
				object.Enabled = state
			end
		end
	end
end

local function SetShadows(value)
	Lighting.GlobalShadows = value
end

local function SetLowGraphics(value)
	if value then
		Lighting.GlobalShadows = false
	else
		Lighting.GlobalShadows = SettingsState.Shadows
	end
end

local Blur

local function SetBlur(value)
	if value then
		if not Blur then
			Blur = Instance.new("BlurEffect")
			Blur.Name = "ControlPanelBlur"
			Blur.Size = 8
			Blur.Parent = Lighting
		end

		Blur.Enabled = true
	else
		if Blur then
			Blur.Enabled = false
		end
	end
end

