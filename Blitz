local function createHeaderControl(symbol, order, hoverColor, onClick)
    local btn = Instance.new("TextButton")

    btn.Name = "Control_" .. symbol
    btn.BackgroundTransparency = 1
    btn.BackgroundColor3 = hoverColor or CONTROL_HOVER
    btn.BorderSizePixel = 0
    btn.Size = UDim2.new(0, 32, 0, 30)
    btn.LayoutOrder = order
    btn.Text = symbol
    btn.TextColor3 = TEXT_COLOR
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.Parent = ControlsContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn

    btn.MouseEnter:Connect(function()
        playTween(btn, 0.16, {BackgroundTransparency = 0})
    end)

    btn.MouseLeave:Connect(function()
        playTween(btn, 0.22, {BackgroundTransparency = 1})
    end)

    btn.MouseButton1Click:Connect(onClick)

    return btn
end

