<script>

/* =========================================================
   STATE
========================================================= */

/*
  IMPORTANT:
  No fake accounts are inserted here.

  The application starts with exactly zero accounts.
*/

let accounts = [];


/* =========================================================
   ELEMENTS
========================================================= */

const accountList =
  document.getElementById(
    "accountList"
  );

const accountCount =
  document.getElementById(
    "accountCount"
  );

const footerCount =
  document.getElementById(
    "footerCount"
  );

const searchInput =
  document.getElementById(
    "searchInput"
  );

const modalOverlay =
  document.getElementById(
    "modalOverlay"
  );

const cookieInput =
  document.getElementById(
    "cookieInput"
  );


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(value) {

  return String(value)

    .replaceAll("&", "&amp;")

    .replaceAll("<", "&lt;")

    .replaceAll(">", "&gt;")

    .replaceAll('"', "&quot;")

    .replaceAll("'", "&#039;");

}


/* =========================================================
   EMPTY STATE
========================================================= */

function renderEmptyState() {

  accountList.innerHTML = \`

    <div class="empty-state">

      <div class="empty-box">

        <div class="empty-icon">

          <svg
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="
                M16 21
                v-2
                a4 4 0 0 0-4-4
                H6
                a4 4 0 0 0-4 4
                v2

                M9 11
                a4 4 0 1 0 0-8
                4 4 0 0 0 0 8Z
              "
            />

          </svg>

        </div>


        <div class="empty-title">
          No accounts found
        </div>


        <div class="empty-description">
          Add an account to get started.
        </div>

      </div>

    </div>

  \`;

}


/* =========================================================
   ACCOUNT CARD
========================================================= */

function renderAccount(account) {

  return \`

    <div
      class="account-card"
      data-account-id="\${escapeHtml(account.id)}"
    >


      <div class="account-left">


        <div class="account-avatar">

          <svg
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
              d="
                M20 21
                a8 8 0 0 0-16 0

                M12 13
                a4 4 0 1 0 0-8
                4 4 0 0 0 0 8Z
              "
            />

          </svg>

        </div>


        <div class="account-info">

          <div class="account-name">
            \${escapeHtml(account.name)}
          </div>

          <div class="account-username">
            @\${escapeHtml(account.username)}
          </div>

        </div>


      </div>


      <div class="account-status">

        <div class="status">

          <span class="status-dot"></span>

          Ready

        </div>

      </div>


      <div class="account-actions">


        <button
          class="launch-button"
          data-action="launch"
          data-id="\${escapeHtml(account.id)}"
        >

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >

            <path d="
              M8 5
              V19
              L19 12
              L8 5
              Z
            "/>

          </svg>

          Launch

        </button>


        <button
          class="icon-button delete"
          data-action="delete"
          data-id="\${escapeHtml(account.id)}"
          title="Delete account"
        >

          <svg
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="
                M4 7H20

                M10 11V17
                M14 11V17

                M9 7V4
                H15
                V7

                M6 7
                L7 20
                H17
                L18 7
              "
            />

          </svg>

        </button>


      </div>


    </div>

  \`;

}


/* =========================================================
   RENDER
========================================================= */

function render() {

  const query =
    searchInput.value
      .trim()
      .toLowerCase();


  const filtered =
    accounts.filter(
      account => {

        return (

          account.name
            .toLowerCase()
            .includes(query)

          ||

          account.username
            .toLowerCase()
            .includes(query)

        );

      }
    );


  accountCount.textContent =
    accounts.length;


  footerCount.textContent =
    accounts.length === 1
      ? "1 account"
      : accounts.length + " accounts";


  if (filtered.length === 0) {

    renderEmptyState();

    return;

  }


  accountList.innerHTML =
    filtered
      .map(renderAccount)
      .join("");

}


/* =========================================================
   MODAL OPEN
========================================================= */

function openModal() {

  modalOverlay.classList.add(
    "open"
  );

  cookieInput.value = "";

  setTimeout(
    () => cookieInput.focus(),
    50
  );

}


/* =========================================================
   MODAL CLOSE
========================================================= */

function closeModal() {

  modalOverlay.classList.remove(
    "open"
  );

  cookieInput.value = "";

}


/* =========================================================
   ADD ACCOUNT
========================================================= */

/*
  The raw authentication cookie is deliberately NOT stored
  in localStorage and is NOT sent to the Worker/server.

  The actual secure account-authentication implementation
  should be handled by the native Tauri layer / secure
  credential storage once the desktop application is wired up.
*/

function addAccount() {

  const cookie =
    cookieInput.value.trim();


  if (!cookie) {

    cookieInput.focus();

    return;

  }


  /*
    UI placeholder only.

    Do NOT put the cookie into localStorage.

    A real account should only be created after the native
    authentication layer has securely validated the account
    and returned non-sensitive account information.
  */

  console.log(
    "Account authentication requested."
  );


  closeModal();

}


/* =========================================================
   DELETE ACCOUNT
========================================================= */

function deleteAccount(id) {

  const account =
    accounts.find(
      item => item.id === id
    );


  if (!account) {
    return;
  }


  const confirmed =
    window.confirm(
      "Delete " +
      account.name +
      "?"
    );


  if (!confirmed) {
    return;
  }


  accounts =
    accounts.filter(
      item => item.id !== id
    );


  render();

}


/* =========================================================
   LAUNCH ACCOUNT
========================================================= */

function launchAccount(id) {

  const account =
    accounts.find(
      item => item.id === id
    );


  if (!account) {
    return;
  }


  /*
    Native Tauri launch functionality goes here.

    The frontend should only request the launch.
    Authentication credentials should remain outside
    the webpage layer.
  */

  console.log(
    "Launch requested for:",
    account.username
  );

}


/* =========================================================
   ADD BUTTON
========================================================= */

document
  .getElementById(
    "addAccountButton"
  )
  .addEventListener(
    "click",
    openModal
  );


/* =========================================================
   CLOSE MODAL
========================================================= */

document
  .getElementById(
    "closeModalButton"
  )
  .addEventListener(
    "click",
    closeModal
  );


document
  .getElementById(
    "cancelModalButton"
  )
  .addEventListener(
    "click",
    closeModal
  );


/* =========================================================
   ADD FROM MODAL
========================================================= */

document
  .getElementById(
    "addModalButton"
  )
  .addEventListener(
    "click",
    addAccount
  );


/* =========================================================
   SEARCH
========================================================= */

searchInput.addEventListener(
  "input",
  render
);


/* =========================================================
   MODAL BACKDROP
========================================================= */

modalOverlay.addEventListener(
  "click",
  event => {

    if (
      event.target === modalOverlay
    ) {

      closeModal();

    }

  }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
  "keydown",
  event => {

    if (
      event.key === "Escape" &&
      modalOverlay.classList.contains(
        "open"
      )
    ) {

      closeModal();

    }


    if (
      event.key === "Enter" &&
      modalOverlay.classList.contains(
        "open"
      )
    ) {

      addAccount();

    }

  }
);


/* =========================================================
   ACCOUNT ACTIONS
========================================================= */

accountList.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest(
        "[data-action]"
      );


    if (!button) {
      return;
    }


    const id =
      button.dataset.id;


    const action =
      button.dataset.action;


    if (
      action === "delete"
    ) {

      deleteAccount(id);

    }


    if (
      action === "launch"
    ) {

      launchAccount(id);

    }

  }
);


/* =========================================================
   CLEAR ALL
========================================================= */

document
  .getElementById(
    "clearAllButton"
  )
  .addEventListener(
    "click",
    () => {

      if (
        accounts.length === 0
      ) {

        return;

      }


      const confirmed =
        window.confirm(
          "Delete all accounts?"
        );


      if (!confirmed) {
        return;
      }


      accounts = [];

      render();

    }
  );


/* =========================================================
   TAURI WINDOW
========================================================= */

async function getTauriWindow() {

  try {

    if (
      window.__TAURI__ &&
      window.__TAURI__.window
    ) {

      return window
        .__TAURI__
        .window
        .getCurrentWindow();

    }

  } catch (error) {

    console.log(
      "Tauri window API unavailable."
    );

  }


  return null;

}


/* =========================================================
   MINIMIZE
========================================================= */

document
  .getElementById(
    "minimizeButton"
  )
  .addEventListener(
    "click",
    async () => {

      const window =
        await getTauriWindow();


      if (window) {

        await window.minimize();

      }

    }
  );


/* =========================================================
   MAXIMIZE
========================================================= */

document
  .getElementById(
    "maximizeButton"
  )
  .addEventListener(
    "click",
    async () => {

      const window =
        await getTauriWindow();


      if (window) {

        const maximized =
          await window.isMaximized();


        if (maximized) {

          await window.unmaximize();

        } else {

          await window.maximize();

        }

      }

    }
  );


/* =========================================================
   CLOSE
========================================================= */

document
  .getElementById(
    "closeButton"
  )
  .addEventListener(
    "click",
    async () => {

      const window =
        await getTauriWindow();


      if (window) {

        await window.close();

      }

    }
  );


/* =========================================================
   INITIAL STATE
========================================================= */

render();

</script>

