local function createDropdown(title, options, onChange)
    local drop = Instance.new("Frame")

    drop.Name = "Dropdown"
    drop.BackgroundColor3 = BUTTON_ACTIVE
    drop.BorderSizePixel = 1
    drop.BorderColor3 = ACCENT_COLOR
    drop.Size = UDim2.new(0, 160, 0, 32)
    drop.ZIndex = 10

    local dropCorner = Instance.new("UICorner")
    dropCorner.CornerRadius = UDim.new(0, 4)
    dropCorner.Parent = drop
    addStroke(drop, Color3.fromRGB(84, 105, 135), 1, 0.2)

    local dropText = Instance.new("TextLabel")
    dropText.Name = "Text"
    dropText.BackgroundTransparency = 1
    dropText.Text = title
    dropText.TextColor3 = TEXT_COLOR
    dropText.Font = Enum.Font.GothamMedium
    dropText.TextSize = 13
    dropText.Size = UDim2.new(1, -35, 1, 0)
    dropText.Position = UDim2.new(0, 10, 0, 0)
    dropText.TextXAlignment = Enum.TextXAlignment.Left
    dropText.Parent = drop

    local arrow = Instance.new("TextLabel")
    arrow.Name = "Arrow"
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = SUBTEXT_COLOR
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 10
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -25, 0, 0)
    arrow.Parent = drop

    local clickBtn = Instance.new("TextButton")
    clickBtn.Name = "ClickButton"
    clickBtn.Size = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    clickBtn.AutoButtonColor = false
    clickBtn.ZIndex = 11
    clickBtn.Parent = drop

    local menuOpen = false
    local menu

    clickBtn.MouseButton1Click:Connect(function()
        menuOpen = not menuOpen
        playTween(arrow, 0.2, {Rotation = menuOpen and 180 or 0})

        if menuOpen then
            if menu then
                menu:Destroy()
            end

            menu = Instance.new("Frame")
            menu.Name = "DropdownMenu"
            menu.BackgroundColor3 = CARD_COLOR
            menu.BorderSizePixel = 1
            menu.BorderColor3 = ACCENT_COLOR
            local menuHeight = math.min(#options * 28, 140)
            menu.Size = UDim2.new(0, drop.AbsoluteSize.X, 0, 0)
            menu.Position = UDim2.new(
                0,
                drop.AbsolutePosition.X,
                0,
                drop.AbsolutePosition.Y + drop.AbsoluteSize.Y + 3
            )
            menu.ZIndex = 100
            menu.Parent = ScreenGui

            local menuCorner = Instance.new("UICorner")
            menuCorner.CornerRadius = UDim.new(0, 5)
            menuCorner.Parent = menu
            addStroke(menu, Color3.fromRGB(84, 105, 135), 1, 0.1)
            playTween(menu, 0.22, {
                Size = UDim2.new(0, drop.AbsoluteSize.X, 0, menuHeight)
            })

            local menuLayout = Instance.new("UIListLayout")
            menuLayout.SortOrder = Enum.SortOrder.LayoutOrder
            menuLayout.Parent = menu

            for index, option in ipairs(options) do
                local optionButton = Instance.new("TextButton")

                optionButton.BackgroundColor3 = BUTTON_INACTIVE
                optionButton.BorderSizePixel = 0
                optionButton.Size = UDim2.new(1, 0, 0, 28)
                optionButton.Text = tostring(option)
                optionButton.TextColor3 = TEXT_COLOR
                optionButton.Font = Enum.Font.GothamMedium
                optionButton.TextSize = 13
                optionButton.LayoutOrder = index
                optionButton.ZIndex = 101
                optionButton.Parent = menu

                optionButton.MouseEnter:Connect(function()
                    playTween(optionButton, 0.12, {BackgroundColor3 = BUTTON_ACTIVE})
                end)

                optionButton.MouseLeave:Connect(function()
                    playTween(optionButton, 0.16, {BackgroundColor3 = BUTTON_INACTIVE})
                end)

                optionButton.MouseButton1Click:Connect(function()
                    dropText.Text = tostring(option)
                    menuOpen = false

                    if menu then
                        menu:Destroy()
                        menu = nil
                    end

                    if onChange then
                        onChange(option)
                    end
                end)
            end
        else
            if menu then
                menu:Destroy()
                menu = nil
            end
        end
    end)

    return drop
end

