local function addLog(message, level)
    local colors = {
        info = SUBTEXT_COLOR,
        success = TOGGLE_ON,
        warning = Color3.fromRGB(235, 174, 72)
    }

    local entry = Instance.new("Frame")
    entry.Name = "LogEntry"
    entry.BackgroundColor3 = BUTTON_INACTIVE
    entry.BackgroundTransparency = 1
    entry.BorderSizePixel = 0
    entry.Size = UDim2.new(1, -2, 0, 42)
    logCount = logCount + 1
    entry.LayoutOrder = -logCount
    entry.Parent = ActivityList
    playTween(entry, 0.22, {BackgroundTransparency = 0})

    local entryCorner = Instance.new("UICorner")
    entryCorner.CornerRadius = UDim.new(0, 4)
    entryCorner.Parent = entry

    local marker = Instance.new("Frame")
    marker.BackgroundColor3 = colors[level] or colors.info
    marker.BorderSizePixel = 0
    marker.Size = UDim2.new(0, 3, 1, -12)
    marker.Position = UDim2.new(0, 6, 0, 6)
    marker.Parent = entry

    local timestamp = Instance.new("TextLabel")
    timestamp.BackgroundTransparency = 1
    timestamp.Text = os.date("%H:%M:%S")
    timestamp.TextColor3 = SUBTEXT_COLOR
    timestamp.Font = Enum.Font.Code
    timestamp.TextSize = 10
    timestamp.Size = UDim2.new(0, 48, 0, 16)
    timestamp.Position = UDim2.new(0, 16, 0, 5)
    timestamp.TextXAlignment = Enum.TextXAlignment.Left
    timestamp.Parent = entry

    local messageLabel = Instance.new("TextLabel")
    messageLabel.BackgroundTransparency = 1
    messageLabel.Text = tostring(message)
    messageLabel.TextColor3 = TEXT_COLOR
    messageLabel.Font = Enum.Font.GothamMedium
    messageLabel.TextSize = 11
    messageLabel.Size = UDim2.new(1, -72, 0, 18)
    messageLabel.Position = UDim2.new(0, 16, 0, 19)
    messageLabel.TextXAlignment = Enum.TextXAlignment.Left
    messageLabel.TextTruncate = Enum.TextTruncate.AtEnd
    messageLabel.Parent = entry

    ActivityList.CanvasPosition = Vector2.new(0, ActivityLayout.AbsoluteContentSize.Y)
end

