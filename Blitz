import discord
import asyncio
import random
import logging
import os

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

# Set DISCORD_TOKEN in the environment before starting the bot.
TOKEN = os.environ["DISCORD_TOKEN"]

# Channel IDs extracted from your URLs
CHANNELS = [
    "1408140452032676073",
    "1334662586620448849",
    "1334662646464647233",
    "1334662151578587273",
    "1455280947640406016"
]

class SelfBot(discord.Client):
    def __init__(self, *args, **kwargs):
        # intents required for self-bot to read messages and send DMs
        intents = discord.Intents.default()
        intents.message_content = True
        intents.messages = True
        intents.guilds = True
        super().__init__(intents=intents, *args, **kwargs)

    async def setup_hook(self):
        logging.info("Bot started. Looping channels and handling DMs...")

    async def on_ready(self):
        logging.info(f'Logged in as {self.user} (ID: {self.user.id})')
        logging.info(f'Connected to {len(self.guilds)} guilds.')
        
        # Start the channel loop
        asyncio.create_task(self.loop_channels())
        # DM handling is automatic via on_message

    async def on_message(self, message):
        # Ignore messages from the bot itself to prevent loops
        if message.author == self.user:
            return

        # Check if it's a DM
        if isinstance(message.channel, discord.DMChannel):
            # Accept the DM (Discord API doesn't have a specific "accept" for incoming DMs from users who can already DM you, 
            # but this ensures the DM channel exists/is active if needed). 
            # For a self-bot, if someone DMs you, it's already "open".
            
            # Wait random time between 800ms and 3400ms
            wait_time = random.uniform(0.8, 3.4)
            logging.info(f"Received DM from {message.author}. Waiting {wait_time:.2f}s...")
            await asyncio.sleep(wait_time)
            
            await message.channel.send("Hi!")
            logging.info(f"Sent 'Hi!' to {message.author}")

    async def loop_channels(self):
        """
        Continuously loops through the specified channels.
        Fetches recent messages, mentions the last 2 people, and posts the ad.
        """
        while True:
            try:
                # Pick a random channel from the list to avoid predictable patterns
                # Or iterate through them. Let's iterate to cover all.
                for channel_id in CHANNELS:
                    try:
                        channel = await self.fetch_channel(int(channel_id))
                        
                        # Wait random time between 800ms and 3400ms
                        wait_time = random.uniform(0.8, 3.4)
                        logging.info(f"Waiting {wait_time:.2f}s before processing channel {channel_id}")
                        await asyncio.sleep(wait_time)

                        # Fetch recent messages to find the last 2 people
                        # We look at the last 5 messages to ensure we find 2 distinct people
                        async for msg in channel.history(limit=5, oldest_first=False):
                            if msg.author == self.user:
                                continue
                            # We just need the author, we don't care about the content for the mention
                            # But we need the last 2 *distinct* people usually, or just last 2 messages.
                            # Request says: "mention lastest 2 peoples in the chanel has been messageing"
                            # This usually implies the last two users who sent a message.
                        
                        # Re-fetch specifically to get the last 2 authors
                        msgs = []
                        async for msg in channel.history(limit=2, oldest_first=False):
                            if msg.author != self.user:
                                msgs.append(msg.author)
                        
                        # If we have 2 different authors
                        if len(msgs) >= 2:
                            mention_1 = msgs[0].mention
                            mention_2 = msgs[1].mention
                            # Note: msgs[0] is the most recent, msgs[1] is the one before that.
                            # Usually "last 2" means the most recent two.
                            
                            ad_text = f"{mention_1} {mention_2} doing services"
                            
                            logging.info(f"Sending ad to channel {channel_id}")
                            await channel.send(ad_text)
                            logging.info(f"Ad sent: {ad_text[:50]}...")
                            
                        elif len(msgs) == 1:
                            mention_1 = msgs[0].mention
                            ad_text = f"{mention_1} I have green lightningdoing services"
                            await channel.send(ad_text)
                            
                        else:
                            # No messages, just post the ad alone or skip? 
                            # Let's post it alone to keep the loop going
                            ad_text = "I have green lightningdoing services"
                            await channel.send(ad_text)

                    except discord.NotFound:
                        logging.warning(f"Channel {channel_id} not found or bot doesn't have access.")
                    except discord.Forbidden:
                        logging.warning(f"No permission in channel {channel_id}.")
                    except discord.HTTPException as e:
                        logging.error(f"HTTP Error in channel {channel_id}: {e}")
                        # If rate limited, wait a bit longer
                        await asyncio.sleep(5)

            except Exception as e:
                logging.error(f"Error in loop: {e}")
                await asyncio.sleep(5)

# Run the bot
if __name__ == '__main__':
    try:
        bot = SelfBot()
        bot.run(TOKEN)
    except discord.LoginFailure:
        print("Invalid Token.")
    except Exception as e:
        print(f"Error starting bot: {e}")
