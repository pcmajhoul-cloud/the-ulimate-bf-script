--==================================================
-- SLIDER CREATOR
--==================================================

local function CreateSlider(parent, title, y, minValue, maxValue, defaultValue, callback)
	local label = MakeText(
		parent,
		title,
		10,
		Colors.SubText,
		Enum.Font.GothamMedium
	)

	label.Position = UDim2.new(0, 14, 0, y)
	label.Size = UDim2.new(0, 150, 0, 18)

	local valueLabel = MakeText(
		parent,
		tostring(defaultValue),
		10,
		Colors.Text,
		Enum.Font.GothamBold
	)

	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Position = UDim2.new(1, -65, 0, y)
	valueLabel.Size = UDim2.new(0, 50, 0, 18)

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -28, 0, 5)
	bar.Position = UDim2.new(0, 14, 0, y + 25)
	bar.BackgroundColor3 = Colors.Off
	bar.BorderSizePixel = 0
	bar.Parent = parent

	AddCorner(bar, 3)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		(defaultValue - minValue) / (maxValue - minValue),
		0,
		1,
		0
	)
	fill.BackgroundColor3 = GetAccent()
	fill.BorderSizePixel = 0
	fill.Parent = bar

	AddCorner(fill, 3)

	local dragging = false

	local function SetFromX(x)
		local percent = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		local value = minValue + (maxValue - minValue) * percent

		valueLabel.Text = tostring(math.floor(value))

		Tween(fill, {
			Size = UDim2.new(percent, 0, 1, 0)
		}, 0.08)

		callback(value)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return {
		Set = function(value)
			local percent = math.clamp(
				(value - minValue) / (maxValue - minValue),
				0,
				1
			)

			valueLabel.Text = tostring(math.floor(value))

			Tween(fill, {
				Size = UDim2.new(percent, 0, 1, 0)
			}, 0.15)

			callback(value)
		end
	}
end

