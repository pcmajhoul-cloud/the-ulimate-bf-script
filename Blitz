      <input
        id="cookieInput"
        class="cookie-input"
        type="password"
        placeholder="Enter your Roblox cookie..."
        autocomplete="off"
        spellcheck="false"
      />

    </div>


    <!-- BUTTONS -->

    <div class="modal-buttons">

      <button
        id="cancelModalButton"
        class="modal-button cancel-button"
      >
