--==================================================
-- FLOATING LOGO DRAGGING
--==================================================

local LogoDragging = false
local LogoDragStart
local LogoStartPosition
local LogoMoved = false

Floating.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		LogoDragging = true
		LogoMoved = false
		LogoDragStart = input.Position
		LogoStartPosition = Floating.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if LogoDragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - LogoDragStart

		if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
			LogoMoved = true
		end

		Floating.Position = UDim2.new(
			LogoStartPosition.X.Scale,
			LogoStartPosition.X.Offset + delta.X,
			LogoStartPosition.Y.Scale,
			LogoStartPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		if LogoDragging and not LogoMoved then
			CardOpen = not CardOpen

			if CardOpen then
				Card.Visible = true

				if not HasCustomCardPosition then
					Card.Position = UDim2.new(0.5, 0, 0.5, 0)
				else
					Card.Position = SavedCardPosition
				end

				Card.Size = UDim2.new(0, CARD_WIDTH, 0, 0)

				Tween(
					Card,
					{
						Size = SavedCardSize
					},
					0.25
				)
			else
				SavedCardPosition = Card.Position

				Tween(
					Card,
					{
						Size = UDim2.new(0, CARD_WIDTH, 0, 0)
					},
					0.2
				)

				task.delay(0.2, function()
					if not CardOpen then
						Card.Visible = false
					end
				end)
			end
		end

		LogoDragging = false
	end
end)

