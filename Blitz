--==================================================
-- PAGE SWITCHING
--==================================================

local function UpdateTabVisuals()
	for name, button in pairs(TabButtons) do
		local selected = name == CurrentPage

		Tween(button, {
			BackgroundColor3 = selected and Colors.Button or Colors.Sidebar
		}, 0.15)

		local icon = button:FindFirstChild("Icon")
		local label = button:FindFirstChild("Label")

		if icon then
			Tween(icon, {
				TextColor3 = selected and GetAccent() or Colors.SubText
			}, 0.15)
		end

		if label then
			Tween(label, {
				TextColor3 = selected and Colors.Text or Colors.SubText
			}, 0.15)
		end
	end

	local selectedButton = TabButtons[CurrentPage]

	if selectedButton then
		Tween(
			ActiveIndicator,
			{
				Position = UDim2.new(
					0,
					0,
					0,
					selectedButton.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y
				),
				BackgroundColor3 = GetAccent()
			},
			0.2
		)
	end
end

local function SwitchPage(page)
	CurrentPage = page

	MainPage.Visible = page == "MAIN"
	SettingsPage.Visible = page == "SETTINGS"
	BlitzPage.Visible = page == "BLITZ"
	AboutPage.Visible = page == "ABOUT"

	UpdateTabVisuals()
end

