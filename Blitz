-- LOGO DRAG LOGIC
local LogoDragging = false
local LogoDragInput = nil
local LogoDragStart = nil
local LogoStartPosition = nil

Floating.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		LogoDragging = true
		LogoDragStart = input.Position
		LogoStartPosition = Floating.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				LogoDragging = false
			end
		end)
	end
end)

Floating.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		LogoDragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == LogoDragInput and LogoDragging then
		local Delta = input.Position - LogoDragStart
		local NewPosition = UDim2.new(
			LogoStartPosition.Scale.X,
			LogoStartPosition.Offset.X + Delta.X,
			LogoStartPosition.Scale.Y,
			LogoStartPosition.Offset.Y + Delta.Y
		)
		Floating.Position = NewPosition
	end
end)

Floating.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		LogoDragging = false
	end
end)

-- CARD DRAG LOGIC
local CardDragging = false
local CardDragStart = nil
local CardStartPosition = nil

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		CardDragging = true
		CardDragStart = input.Position
		CardStartPosition = Card.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				CardDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if CardDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local Delta = input.Position - CardDragStart
		local NewPosition = UDim2.new(
			CardStartPosition.Scale.X,
			CardStartPosition.Offset.X + Delta.X,
			CardStartPosition.Scale.Y,
			CardStartPosition.Offset.Y + Delta.Y
		)
		Card.Position = NewPosition
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		CardDragging = false
	end
end)

