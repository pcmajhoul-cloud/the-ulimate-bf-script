local function createToggle(initialState, onColor, offColor, onChanged)
    local toggle = Instance.new("TextButton")

    toggle.Name = "Toggle"
    toggle.BackgroundColor3 = initialState and onColor or offColor
    toggle.BorderSizePixel = 0
    toggle.Size = UDim2.new(0, 50, 0, 20)
    toggle.AutoButtonColor = false
    toggle.Text = ""

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 10)
    toggleCorner.Parent = toggle

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.BackgroundColor3 = TEXT_COLOR
    knob.BorderSizePixel = 0
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = initialState
        and UDim2.new(0, 32, 0, 2)
        or UDim2.new(0, 2, 0, 2)
    knob.Parent = toggle

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(0, 8)
    knobCorner.Parent = knob

    local currentState = initialState

    toggle.MouseButton1Click:Connect(function()
        currentState = not currentState

        playTween(toggle, 0.2, {
            BackgroundColor3 = currentState and onColor or offColor
        })

        playTween(knob, 0.2, {
            Position = currentState
                and UDim2.new(0, 32, 0, 2)
                or UDim2.new(0, 2, 0, 2)
        })

        if onChanged then
            onChanged(currentState)
        end
    end)

    return toggle
end

